# Bun loads .env automatically. Copy to .env and fill in at least one provider key.

# Default provider: gemini | openai | openrouter | anthropic  (default: gemini)
DEFAULT_LLM_PROVIDER=gemini

# Optional: pin a specific model for the selected provider
# DEFAULT_MODEL=gemini-2.5-pro

# Provider keys — only the one(s) you use are required
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Anthropic extras (optional)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_VERSION=2023-06-01

# Set to "true" to inject recorded learning patterns into vibe check context
# USE_LEARNING_HISTORY=false
