{
  "name": "vibe-cli",
  "version": "1.0.0",
  "description": "Metacognitive AI agent oversight — pure CLI with JSON I/O",
  "type": "module",
  "bin": {
    "vibe": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outfile dist/cli.js --target bun --minify && chmod +x dist/cli.js",
    "dev": "bun run src/cli.ts",
    "verify": "bun fix && bun check && bun run build && bun coverage",
    "coverage": "bun test --coverage",
    "check": "biome check --error-on-warnings . && tsc --noEmit",
    "fix": "biome check --write --unsafe .",
    "migrate": "biome migrate --write"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "commander": "^14.0.3",
    "openai": "^6.38.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.8.0",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT"
}
