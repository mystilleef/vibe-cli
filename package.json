{
  "name": "vibe-cli",
  "version": "1.0.0",
  "description": "Metacognitive AI agent oversight — pure CLI with JSON I/O",
  "type": "module",
  "bin": {
    "vibe": "dist/vibe"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write --unsafe .",
    "migrate": "biome migrate --write",
    "coverage": "bun test --coverage",
    "dev": "bun run src/cli.ts",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/vibe",
    "check": "bun lint && bun typecheck",
    "verify": "bun migrate && bun fix && bun typecheck && bun run build && bun coverage"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "commander": "^14.0.3",
    "openai": "^6.38.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.8.0",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT"
}
