{
  "name": "vibe-cli",
  "version": "0.1.0",
  "description": "Metacognitive AI agent oversight — pure CLI with JSON I/O",
  "type": "module",
  "bin": {
    "vibe": "dist/vibe"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write --unsafe --error-on-warnings .",
    "migrate": "biome migrate --write",
    "coverage": "bun test --parallel --parallel-delay=0",
    "dev": "bun run src/cli.ts",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/vibe",
    "check": "bun lint && bun typecheck",
    "verify": "bun migrate && bun check && bun run build && bun coverage"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "commander": "^15.0.0",
    "openai": "^6.47.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT"
}
